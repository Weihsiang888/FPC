@page "/"
<PageTitle>歡迎 - Techman Robot</PageTitle>

<div class="index-container">
    <section class="index-hero">
        <div class="index-hero-content">
            <h1 class="tm-h1">協作機器人<br/>智慧製造新未來</h1>
            <p class="tm-h3" style="color: var(--tm-text-secondary); margin-top: var(--tm-spacing-md);">
                歡迎使用 Techman Robot 工業管理平台
            </p>
            <div class="index-hero-actions">
                <TmButton ButtonType="Primary" Size="Large" Text="開始使用" OnClick="@(() => NavigateTo("/counter"))" />
                <TmButton ButtonType="Secondary" Size="Large" Text="了解更多" OnClick="@(() => NavigateTo("/weather"))" />
            </div>
        </div>
    </section>

    <section class="index-features">
        <div class="index-features-grid">
            <TmCard Title="計數器" 
                    Description="即時數據計數與統計分析，追蹤生產效能"
                    CardStyle="Hover"
                    Clickable="true"
                    OnClick="@(() => NavigateTo("/counter"))">
                <div class="feature-icon-wrapper">
                    <svg class="feature-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M2 17L12 22L22 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M2 12L12 17L22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
            </TmCard>

            <TmCard Title="天氣監控" 
                    Description="工廠環境溫濕度監控，確保最佳生產條件"
                    CardStyle="Hover"
                    Clickable="true"
                    OnClick="@(() => NavigateTo("/weather"))">
                <div class="feature-icon-wrapper">
                    <svg class="feature-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M18 10C18 6.68629 15.3137 4 12 4C8.68629 4 6 6.68629 6 10C6 12.6131 7.33689 14.8925 9.35672 16.2007C9.76972 16.5 10 17 10 17.5V19C10 20.1046 10.8954 21 12 21C13.1046 21 14 20.1046 14 19V17.5C14 17 14.2303 16.5 14.6433 16.2007C16.6631 14.8925 18 12.6131 18 10Z" stroke="currentColor" stroke-width="2"/>
                    </svg>
                </div>
            </TmCard>

            <TmCard Title="機台管理" 
                    Description="全面的機台設備管理與遠端監控系統"
                    CardStyle="Hover"
                    Clickable="true"
                    OnClick="@(() => NavigateTo("/machine"))">
                <div class="feature-icon-wrapper">
                    <svg class="feature-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/>
                        <path d="M9 9H15M9 13H15M9 17H13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                </div>
            </TmCard>
        </div>
    </section>
</div>

@code {
    private void NavigateTo(string url)
    {
        // 導航邏輯已由 NavLink 處理
    }
}